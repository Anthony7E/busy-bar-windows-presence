# Presence source: "local" (Windows sensors) or "graph" (Microsoft Graph API)
PRESENCE_SOURCE=local

# --- BUSY Bar connection (LAN tried first, cloud used as fallback) ---
BUSY_BAR_LAN_IP=192.168.1.100
# PIN shown on the device: Settings -> Developer / API
BUSY_BAR_LAN_TOKEN=
# Token from your BUSY account, used only if the LAN is unreachable
BUSY_BAR_API_TOKEN=

# Seconds between presence checks
POLL_INTERVAL=5

# --- Local detection tuning ---
# Seconds with no keyboard/mouse input before showing AWAY
IDLE_THRESHOLD=300
# Treat Chrome/Edge mic+camera use as a call (catches browser-based meetings)
INCLUDE_BROWSERS=false
# Screen sharing is detected by the floating indicator window Teams opens,
# because Teams never reports screen capture to Windows. Comma separated
# substrings, matched case-insensitively against window titles. Override for a
# non-English Teams UI or another app; find yours with diagnose_share.py.
SCREEN_SHARE_WINDOW_TITLES=Sharing control bar

# --- Microsoft Graph (blocked by Conditional Access on this tenant) ---
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# Let a BUSY session also switch paired smart-home lights (true/false).
TRIGGER_SMART_HOME=false